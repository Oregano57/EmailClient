<Window x:Class="EmailClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EmailClient"
        mc:Ignorable="d"
        Title="Email Client" Height="450" Width="800"
        Loaded="MainWindow_Loaded">
    <Grid x:Name="MainGrid" Background="#66FF96A0">
        <Grid x:Name="LoginGrid" Background="#FF96A0">
              <StackPanel Margin="200,0" HorizontalAlignment="Center">
                  <Label Content="Welcome!" Margin="20,100,20,0" FontSize="40" FontWeight="DemiBold">
                      <Label.LayoutTransform>
                          <ScaleTransform ScaleX="1.5" ScaleY="1.2"/>
                      </Label.LayoutTransform>
                  </Label>
                  <Button Content="Sign In With Google" Click="SignInWithGoogleButton_Click" FontSize="20" Height="30" Margin="0,20,0,0"/>
              </StackPanel>
        </Grid>
        
    </Grid>
</Window>