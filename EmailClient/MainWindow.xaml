<Window x:Class="EmailClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EmailClient"
        mc:Ignorable="d"
        Title="Email Client" Height="450" Width="800"
        Loaded="MainWindow_Loaded">
    <Grid x:Name="DefaultGrid">
        <Grid x:Name="LoginGrid" Background="#FF96A0" d:IsHidden="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                  <Label Content="Welcome!" HorizontalAlignment="Center" FontSize="40" FontWeight="DemiBold">
                      <Label.LayoutTransform>
                          <ScaleTransform ScaleX="1.5" ScaleY="1.3"/>
                      </Label.LayoutTransform>
                  </Label>
                  <Button Content="Sign In With Google" Click="SignInWithGoogleButton_Click" FontSize="20" Height="33"/>
              </StackPanel>
        </Grid>
        <Grid x:Name="MainGrid" Background="#66FF96A0">
            <DockPanel Height="30" Background="BlanchedAlmond" VerticalAlignment="Top" LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="Sign Out" Click="SignOutButton_Click" Background="Beige" Margin="5" FontWeight="Bold" FontSize="10" Width="50" Height="20"/>
                <Button DockPanel.Dock="Right" Content="Notifications" Click="NotificationsButton_Click" x:Name="NotificationsButtonElement" Background="Beige" FontWeight="Bold" FontSize="10" Width="80" Height="20"/>
            </DockPanel>
            <ListBox Margin="0,30,0,0" ItemsSource="{Binding Labels}" Width="170" HorizontalAlignment="Left" Background="LightCoral">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="Coral" CornerRadius="10, 5,5,10" Padding="3" Margin="2">
                            <TextBlock Text="{Binding}" FontSize="12" FontWeight="Bold"/>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </Grid>
        <Grid x:Name="NotificationsGrid" Background="Bisque" Margin="0,30,0,0" d:IsHidden="False">
            
        </Grid>    
    </Grid>
</Window>